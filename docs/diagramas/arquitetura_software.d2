# Arquitetura de software (camadas) — proposta preliminar (Semana 1)
# Reflete src/sentinel/{app,services,infra}. Simplificado: setas so entre
# camadas adjacentes, exceto o miolo da decisao MFA (destaque proposital).

direction: down

aplicacao: "Aplicacao" {
  style.fill: "#dbe9f6"
  maquina_estados: "Maquina de estados\nVIGIA -> FATOR1 -> FATOR2 -> ATUA" { shape: rectangle }
  cadastro: "Cadastro\n(enrolamento 2 fatores)" { shape: rectangle }
}

servicos: "Servicos" {
  style.fill: "#e6f4ea"
  reconhecimento_facial: "Fator 1\nReconhecimento facial" { shape: rectangle }
  verificacao_fator2: "Fator 2\nPIN / RFID (a definir)" { shape: rectangle }
  decisao_mfa: "Decisao MFA\n(E: Fator 1 E Fator 2)" { shape: rectangle; style.stroke-width: 2 }
  auditoria: "Log / auditoria" { shape: rectangle }

  reconhecimento_facial -> decisao_mfa
  verificacao_fator2 -> decisao_mfa
  decisao_mfa -> auditoria
}

infraestrutura: "Infraestrutura" {
  style.fill: "#fff3cd"
  captura: "Captura\n(camera)" { shape: rectangle }
  gpio: "GPIO\n(sensores/atuadores)" { shape: rectangle }
  persistencia: "Persistencia\n(SQLite)" { shape: rectangle }
  lcd_drv: "LCD" { shape: rectangle }
}

so: "SO: Raspberry Pi OS (Linux)" {
  shape: rectangle
  style.fill: "#f1f1f1"
}

aplicacao -> servicos: "usa"
servicos -> infraestrutura: "usa"
infraestrutura -> so: "drivers"
