# Arquitetura física
# Segundo fator: teclado 4x4 E leitor RFID (alternativos entre si em cada tentativa).
# Atuador: rele + solenoide (fail-secure, requisito) OU servo (apenas demonstracao).

rpi: "Raspberry Pi 3 Model B+\n(BCM2837B0, 4x Cortex-A53)" {
  shape: rectangle
}

pir: "Sensor PIR\nHC-SR501" {
  shape: rectangle
}

camera: "Camera Module v2\n(CSI)\n[externo ao kit]" {
  shape: rectangle
}

botao_cadastro: "Botao de\ncadastro" {
  shape: rectangle
}

fator2: "Fator 2\nTeclado 4x4 e\nleitor RFID MFRC522" {
  shape: rectangle
}

lcd: "LCD1602\n(I2C)" {
  shape: rectangle
}

led_verde: "LED verde" {
  shape: rectangle
}

led_vermelho: "LED vermelho" {
  shape: rectangle
}

buzzer: "Buzzer ativo" {
  shape: rectangle
}

rele: "Modulo rele" {
  shape: rectangle
}

fechadura: "Fechadura\nsolenoide 12V\n[externa ao kit]" {
  shape: rectangle
}

fonte12v: "Fonte 12V\nindependente" {
  shape: rectangle
}

servo: "Servo SG90\n[atuador alternativo\napenas demonstracao]" {
  shape: rectangle
  style.stroke-dash: 3
}

pir -> rpi: "GPIO (IRQ)"
botao_cadastro -> rpi: "GPIO (IRQ)"
fator2 -> rpi: "GPIO / I2C / SPI"
camera -> rpi: "CSI"
rpi -> lcd: "I2C"
rpi -> led_verde: "GPIO"
rpi -> led_vermelho: "GPIO"
rpi -> buzzer: "GPIO"
rpi -> rele: "GPIO"
rele -> fechadura: "12V"
fonte12v -> fechadura: "alimentacao"
rpi -> servo: "PWM (GPIO18)" {
  style.stroke-dash: 3
}
