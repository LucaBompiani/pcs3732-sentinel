# Configuração do Sentinel. Copie para `.env` no Raspberry Pi:
#
#     cp .env.example .env
#
# `./scripts/run-pi.sh` carrega este arquivo sem sobrescrever variáveis já
# exportadas na shell. `.env` está no .gitignore — não versione segredos.

# Backend de hardware: mock | real
SENTINEL_BACKEND=real

# Atuador do acesso: solenoid (relé, fail-secure) | servo (demonstração)
SENTINEL_LOCK_TYPE=servo

# Caminho do banco SQLite
SENTINEL_DB_PATH=sentinel.db

# PIN mestre do operador exigido no cadastro (RF08). TROQUE ANTES DE USAR.
SENTINEL_MASTER_PIN=0000

# Tunables do fluxo de autenticação
SENTINEL_RELAY_SECONDS=5.0
SENTINEL_FACTOR2_TIMEOUT=15.0
SENTINEL_TOTAL_TIMEOUT=8.0
SENTINEL_FACE_SAMPLES=5

# Distancia maxima aceita entre o rosto capturado e a amostra cadastrada.
# Menor = mais rigoroso (recusa quem esta cadastrado); maior = mais permissivo
# (aceita a pessoa errada). Precisa de calibracao com rostos reais na montagem:
# ver docs/operacao.md, secao 6.
SENTINEL_FACE_THRESHOLD=0.55

# Bloqueio por tentativas (RF10)
SENTINEL_MAX_FAILURES=3
SENTINEL_LOCKOUT_SECONDS=60.0

# Timeout de espera por presença; vazio ou "none" bloqueia indefinidamente
# SENTINEL_PRESENCE_TIMEOUT=none
